<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-padding: 20;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.sando_nation.screen.CheckoutController">

    <Label text="Checkout"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label fx:id="orderLabel"
           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

    <TextArea fx:id="orderSummary"
              editable="false"
              prefHeight="300"
              prefWidth="500"
              style="-fx-font-family: monospace;"/>

    <Label fx:id="totalLabel"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Confirm Order"
                onAction="#handleConfirm"
                prefWidth="150" prefHeight="40"
                style="-fx-background-color: green; -fx-text-fill: white;"/>
        <Button fx:id="cancelButton"
                text="Cancel Order"
                onAction="#handleCancel"
                prefWidth="150" prefHeight="40"
                style="-fx-background-color: red; -fx-text-fill: white;"/>
    </HBox>

</VBox>